#: app.py:638
msgid "Viewer accounts cannot make changes."
msgstr "Llogaritë me rol Shikues nuk mund të bëjnë ndryshime."

#: app.py:655
msgid "Invalid username or password."
msgstr "Emër përdoruesi ose fjalëkalim i pavlefshëm."

#: app.py:728
msgid "Profile updated."
msgstr "Profili u përditësua."

#: app.py:735
msgid "Current password is incorrect."
msgstr "Fjalëkalimi aktual është i gabuar."

#: app.py:737
msgid "New password must be at least 6 characters."
msgstr "Fjalëkalimi i ri duhet të ketë të paktën 6 karaktere."

#: app.py:739
msgid "New passwords do not match."
msgstr "Fjalëkalimet e reja nuk përputhen."

#: app.py:743
msgid "Password changed."
msgstr "Fjalëkalimi u ndryshua."

#: app.py:757
#, python-format
msgid "Password reset email sent to %(email)s."
msgstr "Email-i për rivendosjen e fjalëkalimit u dërgua te %(email)s."

#: app.py:759
#, python-format
msgid "Could not send reset email: %(error)s"
msgstr "E-mail-i i rivendosjes nuk mund të dërgohej: %(error)s"

#: app.py:761
msgid "No email on file for this account."
msgstr "Nuk ka email të regjistruar për këtë llogari."

#: app.py:766 app.py:2052
msgid "Please choose an image file."
msgstr "Ju lutemi zgjidhni një skedar imazhi."

#: app.py:770
msgid "Photo must be PNG, JPG, or WEBP."
msgstr "Foto duhet të jetë PNG, JPG, ose WEBP."

#: app.py:778
msgid "Photo updated."
msgstr "Foto u përditësua."

#: app.py:785
msgid "Photo removed."
msgstr "Foto u hoq."

#: app.py:837
msgid ""
"If an account exists for that email, a reset link is on its way. Check your "
"inbox in the next few minutes."
msgstr ""
"Nëse ekziston një llogari për këtë email, një lidhje rivendosjeje po ju "
"vjen. Kontrolloni inbox-in tuaj në minutat e ardhshme."

#: app.py:850
msgid "Invalid or unknown reset link."
msgstr "Lidhje rivendosjeje e pavlefshme ose e panjohur."

#: app.py:852
msgid "This reset link has already been used."
msgstr "Kjo lidhje rivendosjeje është përdorur tashmë."

#: app.py:854
msgid "This reset link has expired. Request a new one."
msgstr "Kjo lidhje rivendosjeje ka skaduar. Kërkoni një të re."

#: app.py:863 app.py:1129
msgid "Password must be at least 6 characters."
msgstr "Fjalëkalimi duhet të ketë të paktën 6 shkronja."

#: app.py:866 app.py:1132
msgid "Passwords do not match."
msgstr "Fjalëkalimet nuk përputhen."

#: app.py:871
msgid "Password updated. You can now sign in with your new password."
msgstr ""
"Fjalëkalimi u përditësua. Tani mund të identifikoheni me fjalëkalimin e ri."

#: app.py:893
msgid "You do not have access to that project."
msgstr "Nuk keni qasje në këtë projekt."

#: app.py:932
msgid ""
"Project key must start with a letter/number and contain only lowercase "
"letters, numbers, - or _."
msgstr ""
"Çelësi i projektit duhet të fillojë me një shkronjë/numër dhe të përmbajë "
"vetëm shkronja të vogla, numra, - ose _."

#: app.py:934
msgid "A project with that key already exists."
msgstr "Një projekt me këtë çelës ekziston tashmë."

#: app.py:936
msgid "Display name is required."
msgstr "Emri i shfaqjes është i detyrueshëm."

#: app.py:958
#, python-format
msgid "Project \"%(name)s\" created and ready to use."
msgstr "Projekti \"%(name)s\" u krijua dhe është gati për përdorim."

#: app.py:1013
msgid "A valid email address is required."
msgstr "Kërkohet një adresë email e vlefshme."

#: app.py:1018
msgid "Only a global superadmin can send a global-scope invite."
msgstr ""
"Vetëm një superadministrator global mund të dërgojë një ftesë me shtrirje "
"globale."

#: app.py:1021 app.py:1029 app.py:1234
msgid "Unknown role."
msgstr "Rol i panjohur."

#: app.py:1026
msgid ""
"\"superadmin\" is a global-only role — invite as admin instead, or use a "
"global invite."
msgstr ""
"\"superadmin\" është rol vetëm global — ftojeni si admin në vend të kësaj, "
"ose përdorni një ftesë globale."

#: app.py:1039
#, python-format
msgid ""
"\"%(username)s\" already has an account — set their global role to %(role)s."
msgstr ""
"\"%(username)s\" ka tashmë një llogari — roli global u vendos në %(role)s."

#: app.py:1041
#, python-format
msgid "\"%(username)s\" already has access to this project."
msgstr "\"%(username)s\" ka tashmë qasje në këtë projekt."

#: app.py:1045
#, python-format
msgid ""
"\"%(username)s\" already has an account — granted access to this project as "
"%(role)s."
msgstr ""
"\"%(username)s\" ka tashmë një llogari — iu dha qasje në këtë projekt si "
"%(role)s."

#: app.py:1049
msgid " (dry-run — check the server log for the link)"
msgstr " (provë — shikoni regjistrin e serverit për lidhjen)"

#: app.py:1050
#, python-format
msgid "Invite sent to %(email)s%(note)s."
msgstr "Ftesa u dërgua te %(email)s%(note)s."

#: app.py:1059 app.py:1083
msgid "You do not have permission to manage that invite."
msgstr "Nuk keni leje ta menaxhoni këtë ftesë."

#: app.py:1062
msgid "Only pending or expired invites can be resent."
msgstr "Vetëm ftesat në pritje ose të skaduara mund të ridërgohen."

#: app.py:1074
#, python-format
msgid "Invite resent to %(email)s."
msgstr "Ftesa u ridërgua te %(email)s."

#: app.py:1086
msgid "Cannot revoke an invite that was already accepted."
msgstr "Nuk mund të anulohet një ftesë që është pranuar tashmë."

#: app.py:1090
#, python-format
msgid "Invite to %(email)s revoked."
msgstr "Ftesa për %(email)s u anulua."

#: app.py:1102
msgid "Invalid or unknown invite link."
msgstr "Lidhje ftese e pavlefshme ose e panjohur."

#: app.py:1104
msgid "This invite has already been used."
msgstr "Kjo ftesë është përdorur tashmë."

#: app.py:1106
msgid "This invite has been revoked."
msgstr "Kjo ftesë është anuluar."

#: app.py:1108
msgid "This invite has expired. Ask an admin to resend it."
msgstr "Kjo ftesë ka skaduar. Kërkojini një administratori ta ridërgojë."

#: app.py:1120
msgid "Username must be at least 2 characters."
msgstr "Emri i përdoruesit duhet të ketë të paktën 2 shkronja."

#: app.py:1123
msgid "That username is already taken."
msgstr "Ky emër përdoruesi është zënë tashmë."

#: app.py:1126
msgid "That email is already in use by another account."
msgstr "Ky email është në përdorim nga një llogari tjetër."

#: app.py:1148
msgid "Account activated — welcome!"
msgstr "Llogaria u aktivizua — mirësevini!"

#: app.py:1177
#, python-format
msgid "User \"%(username)s\" updated."
msgstr "Përdoruesi \"%(username)s\" u përditësua."

#: app.py:1190
msgid "Cannot remove your own access to this project."
msgstr "Nuk mund të hiqni qasjen tuaj në këtë projekt."

#: app.py:1195
#, python-format
msgid ""
"\"%(username)s\" has no project-specific override here — their global role "
"(if any) is what grants their access."
msgstr ""
"\"%(username)s\" nuk ka asnjë rregull të veçantë për këtë projekt — qasja e "
"tyre përcaktohet nga roli global (nëse ka)."

#: app.py:1202
#, python-format
msgid ""
"Removed \"%(username)s\"'s project-specific override — their global %(role)s"
" role still applies here."
msgstr ""
"U hoq rregulli i veçantë i \"%(username)s\" për projektin — roli global "
"%(role)s vazhdon të vlejë këtu."

#: app.py:1205
#, python-format
msgid "Removed \"%(username)s\"'s access to this project."
msgstr "U hoq qasja e \"%(username)s\" në këtë projekt."

#: app.py:1216
msgid "Unknown project."
msgstr "Projekt i panjohur."

#: app.py:1218
#, python-format
msgid "\"%(username)s\" already has access to %(project)s."
msgstr "\"%(username)s\" ka tashmë qasje në %(project)s."

#: app.py:1222
#, python-format
msgid "Granted \"%(username)s\" access to %(project)s as %(role)s."
msgstr "Iu dha \"%(username)s\" qasje në %(project)s si %(role)s."

#: app.py:1232
msgid "Cannot remove your own global superadmin access."
msgstr "Nuk mund të hiqni qasjen tuaj si superadministrator global."

#: app.py:1238
msgid "none"
msgstr "asnjë"

#: app.py:1239
#, python-format
msgid "\"%(username)s\"'s global role is now %(role)s."
msgstr "Roli global i \"%(username)s\" tani është %(role)s."

