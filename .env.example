ANTHROPIC_API_KEY=your-api-key-here

# Email (password reset). Leave SMTP_HOST empty for dry-run mode — reset
# emails are printed to the server log instead of actually being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=scheduler@kikxxl-evrotarget.com
SMTP_PASS=your-smtp-app-password
MAIL_FROM=KiKxxl-evroTarget Workforce Scheduler <scheduler@kikxxl-evrotarget.com>
APP_BASE_URL=http://localhost:5050

# Internal read-only API for Cerebro (AI Hub) integration. Must be
# byte-identical to Cerebro's own SHIFTPLANNER_API_KEY — it's a shared secret,
# not two independently generated keys.
SHIFTPLANNER_API_KEY=generate-with-secrets.token_urlsafe(32)
